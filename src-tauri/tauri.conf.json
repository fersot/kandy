{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kandy",
  "mainBinaryName": "kandy",
  "version": "0.1.0",
  "identifier": "io.github.fersot.Kandy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kandy",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Calendario unificado",
    "longDescription": "Kandy reúne en un solo calendario tus cuentas de Google, Microsoft 365/Outlook, Zoho, servidores CalDAV y suscripciones ICS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
